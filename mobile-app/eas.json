        "EXPO_PUBLIC_API_BASE_URL": "https://bnwlaundry.up.railway.app/api",
        "EXPO_PUBLIC_PAYHERE_MERCHANT_ID": "1234059"
      }
    }
  },
  "submit": {
    "production": {}
  }
